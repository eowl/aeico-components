{
  "name": "aeico-components",
  "version": "0.1.11",
  "description": "Built-in UI components for the Aeico Web Components framework",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles/variables.css": "./src/styles/variables.css",
    "./styles/layout.css": "./src/styles/layout.css",
    "./styles/radius.css": "./src/styles/radius.css",
    "./styles/variables": {
      "types": "./dist/types/styles/variables.d.ts",
      "import": "./dist/styles/variables.js",
      "require": "./dist/styles/variables.cjs"
    },
    "./styles/layout": {
      "types": "./dist/types/styles/layout.d.ts",
      "import": "./dist/styles/layout.js",
      "require": "./dist/styles/layout.cjs"
    },
    "./styles/radius": {
      "types": "./dist/types/styles/radius.d.ts",
      "import": "./dist/styles/radius.js",
      "require": "./dist/styles/radius.cjs"
    },
    "./*": {
      "types": "./dist/types/*/index.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.cjs"
    }
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "src"
  ],
  "sideEffects": [
    "./src/**/*.ts",
    "./src/styles/variables.css",
    "./src/styles/layout.css",
    "./src/styles/radius.css",
    "./dist/*.js",
    "./dist/*.cjs",
    "./dist/chunks/*.js",
    "./dist/chunks/*.cjs",
    "./dist/styles/*.js",
    "./dist/styles/*.cjs"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-cjs.mjs && node scripts/build-styles.mjs && tsc --declaration --emitDeclarationOnly --outDir dist/types -p tsconfig.json",
    "dev": "node scripts/build.mjs --watch",
    "dev:example": "vite --config vite.example.config.ts",
    "dev:example:components": "vite --config vite.example.config.ts",
    "dev:example:simple": "cd examples/simple && vite",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "web-test-runner --config web-test-runner.config.mjs",
    "test:watch": "web-test-runner --config web-test-runner.config.mjs --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "ui",
    "components",
    "aeico"
  ],
  "author": "Eowl",
  "license": "MIT",
  "peerDependencies": {
    "aeico": "^0.1.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@esm-bundle/chai": "^4.3.4-fix.0",
    "@types/mocha": "^10.0.10",
    "@web/dev-server-esbuild": "^1.0.5",
    "@web/test-runner": "^0.20.2",
    "@web/test-runner-playwright": "^0.11.1",
    "aeico": "^0.1.8",
    "aeico-localize": "^0.1.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.0.0",
    "prettier": "^3.8.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^6.2.0"
  }
}
