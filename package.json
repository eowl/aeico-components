{
  "name": "aeico-components",
  "version": "0.1.3",
  "description": "Built-in UI components for the Aeico Web Components framework",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".":             { "types": "./dist/types/index.d.ts",              "import": "./dist/index.js",        "require": "./dist/index.cjs"        },
    "./alert":       { "types": "./dist/types/alert/index.d.ts",        "import": "./dist/alert.js",        "require": "./dist/alert.cjs"        },
    "./badge":       { "types": "./dist/types/badge/index.d.ts",        "import": "./dist/badge.js",        "require": "./dist/badge.cjs"        },
    "./breadcrumb":  { "types": "./dist/types/breadcrumb/index.d.ts",   "import": "./dist/breadcrumb.js",   "require": "./dist/breadcrumb.cjs"   },
    "./button":      { "types": "./dist/types/button/index.d.ts",       "import": "./dist/button.js",       "require": "./dist/button.cjs"       },
    "./button-group":{ "types": "./dist/types/button-group/index.d.ts", "import": "./dist/button-group.js", "require": "./dist/button-group.cjs" },
    "./card":        { "types": "./dist/types/card/index.d.ts",         "import": "./dist/card.js",         "require": "./dist/card.cjs"         },
    "./checkbox":    { "types": "./dist/types/checkbox/index.d.ts",     "import": "./dist/checkbox.js",     "require": "./dist/checkbox.cjs"     },
    "./detail":      { "types": "./dist/types/detail/index.d.ts",       "import": "./dist/detail.js",       "require": "./dist/detail.cjs"       },
    "./dialog":      { "types": "./dist/types/dialog/index.d.ts",       "import": "./dist/dialog.js",       "require": "./dist/dialog.cjs"       },
    "./divider":     { "types": "./dist/types/divider/index.d.ts",      "import": "./dist/divider.js",      "require": "./dist/divider.cjs"      },
    "./dropdown":    { "types": "./dist/types/dropdown/index.d.ts",     "import": "./dist/dropdown.js",     "require": "./dist/dropdown.cjs"     },
    "./icon":        { "types": "./dist/types/icon/index.d.ts",         "import": "./dist/icon.js",         "require": "./dist/icon.cjs"         },
    "./icon-button": { "types": "./dist/types/icon-button/index.d.ts",  "import": "./dist/icon-button.js",  "require": "./dist/icon-button.cjs"  },
    "./navbar":      { "types": "./dist/types/navbar/index.d.ts",       "import": "./dist/navbar.js",       "require": "./dist/navbar.cjs"       },
    "./radio-group": { "types": "./dist/types/radio-group/index.d.ts",  "import": "./dist/radio-group.js",  "require": "./dist/radio-group.cjs"  },
    "./select":      { "types": "./dist/types/select/index.d.ts",       "import": "./dist/select.js",       "require": "./dist/select.cjs"       },
    "./slider":      { "types": "./dist/types/slider/index.d.ts",       "import": "./dist/slider.js",       "require": "./dist/slider.cjs"       },
    "./switch":      { "types": "./dist/types/switch/index.d.ts",       "import": "./dist/switch.js",       "require": "./dist/switch.cjs"       },
    "./tabs":        { "types": "./dist/types/tabs/index.d.ts",         "import": "./dist/tabs.js",         "require": "./dist/tabs.cjs"         },
    "./tag":         { "types": "./dist/types/tag/index.d.ts",          "import": "./dist/tag.js",          "require": "./dist/tag.cjs"          },
    "./text-input":  { "types": "./dist/types/text-input/index.d.ts",   "import": "./dist/text-input.js",   "require": "./dist/text-input.cjs"   }
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "src"
  ],
  "sideEffects": [
    "./dist/alert.js",
    "./dist/alert.cjs",
    "./dist/badge.js",
    "./dist/badge.cjs",
    "./dist/breadcrumb.js",
    "./dist/breadcrumb.cjs",
    "./dist/button.js",
    "./dist/button.cjs",
    "./dist/button-group.js",
    "./dist/button-group.cjs",
    "./dist/card.js",
    "./dist/card.cjs",
    "./dist/checkbox.js",
    "./dist/checkbox.cjs",
    "./dist/detail.js",
    "./dist/detail.cjs",
    "./dist/dialog.js",
    "./dist/dialog.cjs",
    "./dist/divider.js",
    "./dist/divider.cjs",
    "./dist/dropdown.js",
    "./dist/dropdown.cjs",
    "./dist/icon.js",
    "./dist/icon.cjs",
    "./dist/icon-button.js",
    "./dist/icon-button.cjs",
    "./dist/navbar.js",
    "./dist/navbar.cjs",
    "./dist/radio-group.js",
    "./dist/radio-group.cjs",
    "./dist/select.js",
    "./dist/select.cjs",
    "./dist/slider.js",
    "./dist/slider.cjs",
    "./dist/switch.js",
    "./dist/switch.cjs",
    "./dist/tabs.js",
    "./dist/tabs.cjs",
    "./dist/tag.js",
    "./dist/tag.cjs",
    "./dist/text-input.js",
    "./dist/text-input.cjs",
    "./dist/chunks/*.js",
    "./dist/chunks/*.cjs"
  ],
  "scripts": {
    "build": "vite build && tsc --declaration --emitDeclarationOnly --outDir dist/types -p tsconfig.json",
    "dev": "vite build --watch",
    "dev:example": "vite --config vite.example.config.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "web-test-runner --config web-test-runner.config.mjs",
    "test:watch": "web-test-runner --config web-test-runner.config.mjs --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "ui",
    "components",
    "aeico"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "aeico": "^0.1.3",
    "aeico-localize": "^0.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@esm-bundle/chai": "^4.3.4-fix.0",
    "@types/mocha": "^10.0.10",
    "@web/dev-server-esbuild": "^1.0.5",
    "@web/test-runner": "^0.20.2",
    "@web/test-runner-playwright": "^0.11.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.0.0",
    "prettier": "^3.8.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^6.2.0"
  }
}
